---
import logo from "../../../docs/assets/logo.svg?raw";
import { toolsets, totals } from "../lib/tools";

const GITHUB = "https://github.com/mattoddie/proxmox-mcp";
const title = "proxmox-mcp: talk to your Proxmox cluster";
const description =
  "An open-source MCP server for Proxmox VE. Ask Claude and other AI assistants about your VMs, containers, storage, backups and cluster, and let them make changes when you allow it. Runs in Docker.";

const toolsetIcons: Record<string, string> = {
  cluster: "🧭",
  nodes: "🖥️",
  vms: "💻",
  containers: "📦",
  agent: "🔌",
  snapshots: "📸",
  storage: "💾",
  backup: "🛟",
  tasks: "⏱️",
  access: "🔑",
  firewall: "🧱",
  ha: "♻️",
  sdn: "🌐",
  ceph: "🐙",
  pools: "🗂️",
  replication: "🔁",
  notifications: "🔔",
  hardware: "🧩",
  raw: "🧪",
};

const examples = [
  { icon: "🩺", q: "Give me a health check of the cluster.", tools: ["get_cluster_status", "get_ceph_status", "list_node_updates"] },
  { icon: "🛟", q: "Which guests have no backup from this week? Back them up now.", tools: ["list_unbacked_guests", "backup_guests"] },
  { icon: "📸", q: "Find snapshots older than 30 days and how much space they hold.", tools: ["list_all_snapshots"] },
  { icon: "🧬", q: "Clone the ubuntu-24 template as web-03 on pve3 and start it.", tools: ["clone_vm", "vm_power"] },
  { icon: "💾", q: "Which storage fills up first, and do any disks have SMART warnings?", tools: ["list_storage", "list_disks"] },
  { icon: "🔍", q: "Check free disk space inside the db VM.", tools: ["get_vm", "guest_exec"] },
];

const setups = ["Proxmox VE 9.x", "Proxmox VE 8.x", "Single node", "Multi-node cluster", "Ceph", "ZFS & LVM", "Proxmox Backup Server storage"];
const clients = ["Claude Code", "Claude Desktop", "VS Code", "Cursor", "Codex", "Any MCP client"];

const raw = GITHUB.replace("github.com", "raw.githubusercontent.com");
const composeSnippet = `curl -fsSLO ${raw}/main/compose.yaml
curl -fsSL ${raw}/main/example.env -o .env
# set PROXMOX_URL, PROXMOX_TOKEN_ID,
# PROXMOX_TOKEN_SECRET and MCP_AUTH_TOKEN in .env
docker compose up -d`;
// The illustrated cluster under the hero (example data). Each node is a small rack with
// three guest slots and an IO-wait meter; db-01 moves from pve2's second slot to pve3's
// empty third slot when the chat migrates it.
const NODE = { w: 250, h: 196, top: 66, slotX: 16, slotW: 218, slotH: 32, slotY: [44, 82, 120] };
const nodes = [
  { name: "pve1", x: 275, guests: [["101", "web-01"], ["102", "web-02"], ["105", "proxy"]] },
  { name: "pve2", x: 595, guests: [["103", "app-01"], null, ["107", "ci-runner"]] },
  { name: "pve3", x: 915, guests: [["110", "dns"], ["112", "media"], null] },
];
const mover = { x: 595 + NODE.slotX, y: NODE.top + NODE.slotY[1] };
const target = { x: 915 + NODE.slotX, y: NODE.top + NODE.slotY[2] };
const connectSnippet = `claude mcp add --transport http proxmox \\
  http://<docker-host>:8080/mcp \\
  --header "Authorization: Bearer <token>"`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0c0709" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareSourceCode",
        name: "proxmox-mcp",
        description,
        url: Astro.site?.href,
        codeRepository: GITHUB,
        license: "https://opensource.org/licenses/MIT",
        runtimePlatform: "Docker",
        author: { "@type": "Person", name: "Matt Oddie", url: "https://mattoddie.dev/" },
        isPartOf: { "@type": "WebSite", name: "MCP servers by Matt Oddie", url: "https://mcp.mattoddie.dev/" },
      })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="proxmox-mcp home">
          <span class="brand-logo" set:html={logo} />
          <span>proxmox-mcp</span>
        </a>
        <nav aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="/docs/tools/">Tools</a>
          <a href="/docs/getting-started/" class="hide-sm">Get started</a>
          <a href="https://mcp.mattoddie.dev/" class="hide-sm">All servers</a>
          <a class="gh" href={GITHUB} aria-label="proxmox-mcp on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            <span class="hide-sm">GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero scene">
        <svg class="mesh" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id="link" x1="0" x2="1">
              <stop offset="0" stop-color="#f97316" />
              <stop offset="0.6" stop-color="#f43f5e" />
              <stop offset="1" stop-color="#d946ef" />
            </linearGradient>
          </defs>
          <g class="links">
            <path d="M110 520 L320 380 L560 470 L820 300 L1080 420" />
            <path d="M320 380 L420 170 L700 120 L820 300" />
            <path d="M560 470 L640 640" />
            <path d="M820 300 L980 140" />
            <path d="M420 170 L180 120" />
            <path d="M1080 420 L1140 610" />
          </g>
          <g class="pulses">
            <path d="M110 520 L320 380 L560 470 L820 300 L1080 420" />
            <path d="M320 380 L420 170 L700 120 L820 300" />
            <path d="M820 300 L980 140" />
          </g>
          <!-- Nodes drawn as small servers: a cluster rather than a mesh. -->
          <g class="nodes">
            <rect x="104" y="514" width="12" height="12" rx="3" /><rect x="311" y="371" width="18" height="18" rx="4" />
            <rect x="554" y="464" width="12" height="12" rx="3" /><rect x="809" y="289" width="22" height="22" rx="5" />
            <rect x="1073" y="413" width="14" height="14" rx="3" /><rect x="414" y="164" width="12" height="12" rx="3" />
            <rect x="693" y="113" width="14" height="14" rx="3" /><rect x="635" y="635" width="10" height="10" rx="2" />
            <rect x="974" y="134" width="12" height="12" rx="3" /><rect x="175" y="115" width="10" height="10" rx="2" />
            <rect x="1135" y="605" width="10" height="10" rx="2" />
          </g>
        </svg>
        <svg class="scene-art" viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
          <defs>
            <linearGradient id="hot" x1="0" x2="1">
              <stop offset="0" stop-color="#f97316" />
              <stop offset="1" stop-color="#f43f5e" />
            </linearGradient>
            <linearGradient id="rack" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2a1820" />
              <stop offset="1" stop-color="#170d12" />
            </linearGradient>
            <filter id="soft" x="-30%" y="-30%" width="160%" height="160%"><feGaussianBlur stdDeviation="14" /></filter>
          </defs>
          <rect class="floor" x="0" y={NODE.top + NODE.h} width="1440" height={300 - NODE.top - NODE.h} />
          <line class="floor-edge" x1="0" y1={NODE.top + NODE.h + 0.5} x2="1440" y2={NODE.top + NODE.h + 0.5} />
          <rect class="warn-glow" x={595 - 6} y={NODE.top - 6} width={NODE.w + 12} height={NODE.h + 12} rx="18" filter="url(#soft)" />
          {
            nodes.map((n, ni) => (
              <g class={`node n${ni + 1}`} transform={`translate(${n.x} ${NODE.top})`}>
                <ellipse class="shadow" cx={NODE.w / 2} cy={NODE.h + 4} rx={NODE.w / 2 + 6} ry="8" />
                <rect class="body" width={NODE.w} height={NODE.h} rx="14" />
                <text class="name" x="18" y="31">{n.name}</text>
                <g class="leds">
                  <circle cx="198" cy="25" r="4" /><circle cx="214" cy="25" r="4" /><circle class="warn" cx="230" cy="25" r="4" />
                </g>
                {n.guests.map((g, si) => (
                  <g transform={`translate(${NODE.slotX} ${NODE.slotY[si]})`}>
                    <rect class="slot" width={NODE.slotW} height={NODE.slotH} rx="8" />
                    {g && (
                      <g class="vm">
                        <rect width={NODE.slotW} height={NODE.slotH} rx="8" />
                        <circle cx="16" cy="16" r="3.5" style={`animation-delay:${-(ni * 3 + si) * 0.37}s`} />
                        <text x="30" y="21"><tspan class="id">{g[0]}</tspan> {g[1]}</text>
                      </g>
                    )}
                  </g>
                ))}
                <text class="meter-label" x="16" y="179">IO wait</text>
                <rect class="track" x="80" y="170" width="110" height="10" rx="5" />
                <rect class="bar" x="80" y="170" width="110" height="10" rx="5" />
                <text class="val v0" x="234" y="179" text-anchor="end">–</text>
                <text class="val v1" x="234" y="179" text-anchor="end">{["9%", "38%", "2%"][ni]}</text>
                <text class="val v2" x="234" y="179" text-anchor="end">{["9%", "6%", "4%"][ni]}</text>
              </g>
            ))
          }
          <g class="badge warn-badge" transform="translate(720 38)">
            <rect x="-112" y="-15" width="224" height="28" rx="14" />
            <text y="4" text-anchor="middle">IO wait high · local-zfs 94%</text>
          </g>
          <g class="badge done-badge" transform="translate(1040 38)">
            <rect x="-112" y="-15" width="224" height="28" rx="14" />
            <text y="4" text-anchor="middle">live-migrated · 41 ms downtime</text>
          </g>
          <path class="route" d={`M${mover.x + NODE.slotW} ${mover.y + 16} C ${mover.x + NODE.slotW + 60} ${mover.y + 16}, ${target.x - 60} ${target.y + 16}, ${target.x} ${target.y + 16}`} />
          <g class="mover" transform={`translate(${mover.x} ${mover.y})`}>
            <g class="mover-inner" style={`--dx:${target.x - mover.x}px;--dy:${target.y - mover.y}px`}>
              <rect width={NODE.slotW} height={NODE.slotH} rx="8" />
              <circle cx="16" cy="16" r="3.5" />
              <text x="30" y="21"><tspan class="id">104</tspan> db-01</text>
            </g>
          </g>
          <text class="caption" x="1165" y="291" text-anchor="end">Illustration · example data</text>
        </svg>

        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot"></span> Open source · MIT · Model Context Protocol</p>
            <h1>Talk to your <span class="grad">Proxmox cluster.</span></h1>
            <p class="lede">
              proxmox-mcp connects Claude and other AI assistants to Proxmox VE. Ask about VMs, containers, storage, backups and
              the cluster in plain English, and let the assistant make changes when you allow it.
            </p>
            <div class="cta">
              <a class="btn primary" href="/docs/getting-started/">Get started <span aria-hidden="true">→</span></a>
              <a class="btn ghost" href={GITHUB}>Star on GitHub</a>
            </div>
            <div class="pull">
              <code>docker pull ghcr.io/mattoddie/proxmox-mcp</code>
              <button class="copy" data-copy="docker pull ghcr.io/mattoddie/proxmox-mcp" aria-label="Copy command">Copy</button>
            </div>
          </div>

          <div class="chat" aria-label="Example conversation">
            <div class="chat-bar"><span></span><span></span><span></span><em>Claude · proxmox</em></div>
            <div class="chat-body" id="chat">
              <div class="msg user" data-step="0">Why is the db VM so slow today?</div>
              <div class="calls" data-step="1">
                <span class="call"><i></i>proxmox_list_guests<b>search: "db"</b></span>
                <span class="call"><i></i>proxmox_get_vm_stats<b>104 · last hour</b></span>
                <span class="call"><i></i>proxmox_get_node_status<b>pve2</b></span>
              </div>
              <div class="msg bot" data-step="2">
                <strong>db-01</strong> (VMID 104) runs on <strong>pve2</strong>, where IO wait has been at <mark>38%</mark> since 9:00.
                Its disk is on <code>local-zfs</code>, which is <mark>94% full</mark> and shared with other busy guests.
                pve3 is quiet, at <mark>2% IO wait</mark> with plenty of free space. Want me to live-migrate db-01 there?
              </div>
              <div class="msg user" data-step="3">Yes, move it.</div>
              <div class="calls" data-step="4">
                <span class="call write"><i></i>proxmox_migrate_vm<b>104 → pve3 · online</b></span>
              </div>
              <div class="msg bot" data-step="5">
                Done. db-01 is now running on pve3 after a live migration with its disk (4 min, <mark>41 ms</mark> of downtime). IO wait
                inside the VM is down to <mark>1%</mark>. ✅
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="stats wrap" aria-label="At a glance">
        <div><strong>{totals.tools}</strong><span>tools</span></div>
        <div><strong>{totals.toolsets}</strong><span>toolsets</span></div>
        <div><strong>{totals.prompts}</strong><span>guided prompts</span></div>
        <div><strong>1</strong><span>Docker container</span></div>
      </section>

      <!-- Examples -->
      <section class="section wrap">
        <div class="section-head">
          <p class="kicker">Ask anything</p>
          <h2>Your cluster, in plain English.</h2>
          <p>
            The assistant picks the right tools, runs them against the Proxmox API and explains what it found. No clicking through
            the web UI node by node.
          </p>
        </div>
        <div class="examples">
          {
            examples.map((e) => (
              <article class="example">
                <span class="ex-icon" aria-hidden="true">{e.icon}</span>
                <p>“{e.q}”</p>
                <div class="ex-tools">
                  {e.tools.map((t) => (
                    <code>{t}</code>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Toolsets -->
      <section class="section wrap" id="toolsets">
        <div class="section-head">
          <p class="kicker">Broad coverage</p>
          <h2>{totals.tools} tools across the whole datacenter.</h2>
          <p>
            Grouped into {totals.toolsets} toolsets you can switch on and off, so the assistant only sees what you need: {`${totals.read} read, ${totals.write} write, ${totals.delete} delete and ${totals.exec} exec tools.`}
          </p>
        </div>
        <div class="toolsets">
          {
            toolsets.map((t) => (
              <a class="toolset" href={`/docs/tools/#${t.name}`}>
                <div class="ts-top">
                  <span class="ts-icon" aria-hidden="true">{toolsetIcons[t.name] ?? "🔧"}</span>
                  <code>{t.name}</code>
                  <span class="ts-count">{t.total}</span>
                </div>
                <p>{t.summary}</p>
                <div class="ts-bar" role="img" aria-label={`${t.read} read, ${t.write} write, ${t.delete} delete, ${t.exec} exec`}>
                  <span class="r" style={`flex:${t.read}`} />
                  <span class="w" style={`flex:${t.write}`} />
                  <span class="d" style={`flex:${t.delete}`} />
                  <span class="x" style={`flex:${t.exec}`} />
                </div>
              </a>
            ))
          }
        </div>
        <p class="legend">
          <span class="r"></span>read <span class="w"></span>write <span class="d"></span>delete <span class="x"></span>exec ·
          <a href="/docs/tools/">Full tool reference →</a>
        </p>
      </section>

      <!-- Safety -->
      <section class="section safety-wrap">
        <div class="wrap safety">
          <div class="section-head left">
            <p class="kicker">Safe by default</p>
            <h2>It can look. It only touches when you say so.</h2>
            <p>
              Tools that aren't allowed aren't registered at all. The assistant can't see them, so it can't call them or be talked into
              calling them.
            </p>
            <ul class="checks">
              <li><strong>Read-only out of the box.</strong> Writes, deletes and in-guest exec are three separate switches.</li>
              <li><strong>Destructive tools are labelled,</strong> so your client asks before running them.</li>
              <li><strong>Least privilege on the Proxmox side too.</strong> Use an API token with only the roles you want to grant.</li>
              <li><strong>Bearer-token auth</strong>, a Host allow-list and a read-only, non-root container.</li>
            </ul>
            <a class="link" href="/docs/security/">Read the security model →</a>
          </div>
          <div class="levels" aria-label="Access levels">
            <div class="level on">
              <div class="lv-head"><span class="pill r">read</span><span class="switch on" aria-hidden="true"></span></div>
              <p><strong>{totals.read} tools</strong>, always on</p>
              <code>list_guests · get_vm_stats · list_backups …</code>
            </div>
            <div class="level">
              <div class="lv-head"><span class="pill w">write</span><span class="switch" aria-hidden="true"></span></div>
              <p><strong>{totals.write} tools</strong> with <code>PROXMOX_ALLOW_WRITES=true</code></p>
              <code>vm_power · clone_vm · migrate_vm · backup_guests …</code>
            </div>
            <div class="level">
              <div class="lv-head"><span class="pill d">delete</span><span class="switch" aria-hidden="true"></span></div>
              <p><strong>{totals.delete} tools</strong> with <code>PROXMOX_ALLOW_DELETES=true</code> as well</p>
              <code>delete_vm · delete_snapshot · delete_backup …</code>
            </div>
            <div class="level">
              <div class="lv-head"><span class="pill x">exec</span><span class="switch" aria-hidden="true"></span></div>
              <p><strong>{totals.exec} tools</strong> with <code>PROXMOX_ALLOW_EXEC=true</code> as well</p>
              <code>guest_exec · guest_write_file · vm_monitor_command …</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Compatibility -->
      <section class="section wrap compat">
        <div>
          <p class="kicker">Works with your cluster</p>
          <h3>Proxmox VE 8 and 9, one node or many</h3>
          <ul class="chips">{setups.map((c) => <li>{c}</li>)}</ul>
          <p class="muted">
            API token or username and password. Self-signed certificates work out of the box. Guests are found by VMID on whichever node
            they're on. <a href="/docs/compatibility/">Compatibility →</a>
          </p>
        </div>
        <div>
          <p class="kicker">Works with your assistant</p>
          <h3>Streamable HTTP or stdio</h3>
          <ul class="chips">{clients.map((c) => <li>{c}</li>)}</ul>
          <p class="muted">
            Run it once and share it, or start it per session with <code>docker run -i</code>. Long tasks are awaited and return their
            log. <a href="/docs/clients/">Client setup →</a>
          </p>
        </div>
      </section>

      <!-- Quick start -->
      <section class="section wrap" id="quick-start">
        <div class="section-head">
          <p class="kicker">Quick start</p>
          <h2>Up and running in three steps.</h2>
        </div>
        <ol class="steps">
          <li>
            <span class="num">1</span>
            <h3>Create an API token</h3>
            <p>
              In the Proxmox web UI, open <strong>Datacenter → Permissions → API Tokens → Add</strong>. Give the token's user the roles
              it needs, such as <strong>PVEAuditor</strong> for read-only.
            </p>
          </li>
          <li>
            <span class="num">2</span>
            <h3>Start the container</h3>
            <div class="code">
              <button class="copy" data-copy={composeSnippet} aria-label="Copy commands">Copy</button>
              <pre><code>{composeSnippet}</code></pre>
            </div>
          </li>
          <li>
            <span class="num">3</span>
            <h3>Connect your assistant</h3>
            <div class="code">
              <button class="copy" data-copy={connectSnippet} aria-label="Copy command">Copy</button>
              <pre><code>{connectSnippet}</code></pre>
            </div>
            <p class="muted">Then ask: <em>“How's my cluster doing?”</em></p>
          </li>
        </ol>
      </section>

      <!-- Final CTA -->
      <section class="final wrap">
        <span class="final-logo" set:html={logo} />
        <h2>Ready to talk to your cluster?</h2>
        <p>Free, open source and MIT licensed. Contributions and compatibility reports are welcome.</p>
        <div class="cta center">
          <a class="btn primary" href="/docs/getting-started/">Read the docs <span aria-hidden="true">→</span></a>
          <a class="btn ghost" href={`${GITHUB}/blob/main/CONTRIBUTING.md`}>Contribute</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap foot-inner">
        <div class="foot-links">
          <a href="/docs/">Docs</a>
          <a href="/docs/tools/">Tools</a>
          <a href={GITHUB}>GitHub</a>
