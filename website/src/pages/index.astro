    <script>
      // Copy buttons
      for (const btn of document.querySelectorAll<HTMLButtonElement>("button.copy")) {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            btn.textContent = "Copied";
          } catch {
            btn.textContent = "Select & copy";
          }
          setTimeout(() => (btn.textContent = "Copy"), 1600);
        });
      }

      // Play the example conversation when the hero is on screen, and loop it. Steps also
      // switch the scene: the diagnosis heats up pve2, the migration moves db-01 to pve3.
      const hero = document.querySelector<HTMLElement>(".hero.scene");
      const chat = document.getElementById("chat");
      const steps = chat ? [...chat.querySelectorAll<HTMLElement>("[data-step]")] : [];
      const sceneAt: Record<number, string> = { 2: "hot", 4: "migrating", 5: "migrated" };
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (hero && chat && reduce) {
        hero.classList.add("hot", "migrated");
      } else if (hero && chat) {
        chat.classList.add("animate");
        const delays = [300, 900, 1900, 1900, 900, 1700];
        let timers: number[] = [];
        let visible = false;
        let running = false;
        const reset = () => {
          timers.forEach(clearTimeout);
          timers = [];
          steps.forEach((el) => el.classList.remove("shown"));
          chat.querySelectorAll(".call").forEach((c) => c.classList.remove("done"));
          hero.classList.remove(...Object.values(sceneAt));
        };
        const play = () => {
          running = true;
          reset();
          let t = 0;
          steps.forEach((el, i) => {
            t += delays[i] ?? 1000;
            timers.push(window.setTimeout(() => {
              el.classList.add("shown");
              if (sceneAt[i]) hero.classList.add(sceneAt[i]);
              for (const [j, c] of [...el.querySelectorAll<HTMLElement>(".call")].entries()) {
                timers.push(window.setTimeout(() => c.classList.add("done"), 450 + j * 380));
              }
            }, t));
          });
          // Hold the finished scene for a while, then start again if the hero is still in view.
          timers.push(window.setTimeout(() => (visible ? play() : (running = false)), t + 7000));
        };
        new IntersectionObserver((entries) => {
          visible = entries.some((e) => e.isIntersecting);
          if (visible && !running) play();
        }, { threshold: 0.2 }).observe(chat);
      }
    </script>

