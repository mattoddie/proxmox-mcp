{
  "name": "proxmox-mcp",
  "version": "0.0.0-dev",
  "description": "Model Context Protocol (MCP) server for Proxmox VE: monitor and manage your cluster, nodes, VMs, containers, storage and backups from Claude and other AI assistants",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "proxmox",
    "proxmox-ve",
    "pve",
    "virtualization",
    "kvm",
    "lxc",
    "claude",
    "ai",
    "homelab"
  ],
  "homepage": "https://github.com/mattoddie/proxmox-mcp#readme",
  "bugs": {
    "url": "https://github.com/mattoddie/proxmox-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattoddie/proxmox-mcp.git"
  },
  "license": "MIT",
  "author": "Matt Oddie",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "proxmox-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test 'dist/test/*.test.js'",
    "docs:tools": "npm run build && node dist/scripts/gen-tool-docs.js",
    "docs:check": "npm run build && node dist/scripts/gen-tool-docs.js --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
