# Copy to .env and fill in:  cp example.env .env
# Every option is explained in docs/configuration.md

# --- Proxmox VE ---------------------------------------------------------------
# URL of any cluster node (or a load balancer in front of them), including the port.
PROXMOX_URL=https://pve.example.lan:8006

# Auth: EITHER an API token (recommended; Datacenter > Permissions > API Tokens)...
#   PROXMOX_TOKEN_ID is user@realm!tokenname, e.g. mcp@pve!mcp
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
#   ...or both in one variable, as Proxmox shows it: user@realm!tokenname=secret
# PROXMOX_API_TOKEN=
# ...OR a username (user@realm) and password. Accounts with 2FA need a token instead.
PROXMOX_USERNAME=
PROXMOX_PASSWORD=

# Proxmox ships with a self-signed certificate, so chain verification is off by default and
# the server warns at startup. Recommended: pin the certificate's SHA-256 fingerprint (Node >
# System > Certificates > pve-ssl.pem or pveproxy-ssl.pem > View Certificate, or on the node:
#   openssl x509 -in /etc/pve/local/pve-ssl.pem -noout -fingerprint -sha256)
# Comma-separate several to allow for a renewal. Use the certificate pveproxy actually serves.
PROXMOX_TLS_FINGERPRINT=
# Or turn verification on with a trusted certificate, or point PROXMOX_CA_FILE at your CA (PEM).
PROXMOX_VERIFY_SSL=false
# PROXMOX_CA_FILE=/run/secrets/pve-ca.pem
PROXMOX_TIMEOUT_MS=30000
# How long tools wait for a Proxmox task (start, clone, backup...) before returning.
PROXMOX_TASK_TIMEOUT_MS=120000
# Node used when a tool needs one and none is given (single-node installs don't need this).
PROXMOX_DEFAULT_NODE=

# Register tools that change state (start/stop guests, create, clone, migrate, configure...).
PROXMOX_ALLOW_WRITES=false
# Also register tools that delete guests, backups, volumes and configuration. Needs writes.
PROXMOX_ALLOW_DELETES=false
# Also register tools that run commands or read/write files inside guests (QEMU guest agent)
# and send QEMU monitor commands. Needs writes.
PROXMOX_ALLOW_EXEC=false
# Comma-separated toolsets to expose (default all). Fewer tools = less context for the model.
# "all" leaves out raw (the raw API tool, which can call any endpoint); add it by name: all,raw
# cluster,nodes,vms,containers,agent,snapshots,storage,backup,tasks,access,firewall,ha,sdn,ceph,pools,replication,notifications,hardware,raw
PROXMOX_TOOLSETS=all
# Let the raw API tool return responses unredacted when called with redact:false (secrets included).
# PROXMOX_ALLOW_UNREDACTED=false

# --- MCP transport ------------------------------------------------------------
# The image defaults to http. Use stdio for `docker run -i` from an MCP client.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Interface to listen on. The image uses 0.0.0.0; outside Docker the default is 127.0.0.1.
# MCP_HTTP_HOST=0.0.0.0
# Required for http (the server won't start without it): clients must send
# "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Only set this to true behind something else that authenticates (e.g. an authenticating
# reverse proxy); without a token anyone who can reach the port can use every enabled tool.
# MCP_ALLOW_UNAUTHENTICATED=false
# Comma-separated Host allow-list (DNS rebinding protection), entries host or host:port; when set,
# requests with an Origin header must also match (an entry without a port only allows the default
# port in Origin). Required with MCP_ALLOW_UNAUTHENTICATED=true.
MCP_ALLOWED_HOSTS=
